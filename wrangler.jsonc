{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Dikunci supaya deploy tidak salah akun (di mesin ini ada >1 akun Cloudflare).
	"account_id": "0f62ed815d87504f78ac48003db9758a",
	"main": ".open-next/worker.js",
	"name": "curated-ootd",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "curated-ootd"
		}
	]
}